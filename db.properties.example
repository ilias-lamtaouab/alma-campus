# Copy this file to "db.properties" (same folder) and fill in your own values.
# db.properties is ignored by Git - never commit real credentials.
db.url=jdbc:mysql://localhost:3306/scolaris_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
db.username=your_db_username
db.password=your_db_password
db.pool.size=10
