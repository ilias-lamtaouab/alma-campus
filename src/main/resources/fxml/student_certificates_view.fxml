<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox spacing="24" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.scolaris.controller.StudentCertificatesController">
    <!-- Notification Banner (Green Alert Box) -->
    <HBox fx:id="notificationBanner" alignment="CENTER_LEFT" spacing="12" 
          style="-fx-background-color: #D1FAE5; -fx-padding: 10 15; -fx-background-radius: 8; -fx-border-color: #6EE7B7; -fx-border-width: 1;"
          visible="false" managed="false">
        <FontAwesomeIconView glyphName="BELL" fill="#065F46" size="16" />
        <Label text="Félicitations ! Votre demande de certificat de scolarité a été acceptée. Vous pouvez la télécharger ci-dessous." 
               style="-fx-text-fill: #065F46; -fx-font-weight: bold; -fx-font-size: 13px;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Fermer" onAction="#handleCloseBanner" style="-fx-background-color: transparent; -fx-text-fill: #065F46; -fx-font-weight: bold; -fx-cursor: hand;" />
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <VBox spacing="5">
            <Label text="Demandes de Certificat" styleClass="header-title" />
            <Label text="Suivi et impression de vos attestations d'inscription officielle" style="-fx-font-size: 13px; -fx-text-fill: #667085;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Nouvelle Demande" onAction="#handleNewRequest" styleClass="btn-primary" minWidth="-Infinity">
            <graphic><FontAwesomeIconView glyphName="PLUS" fill="white" size="14"/></graphic>
        </Button>
    </HBox>

    <VBox styleClass="section-card" VBox.vgrow="ALWAYS" spacing="10">
        <Label text="Historique des Demandes" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #0D9488;" />
        <TableView fx:id="requestTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colReqDate" text="Date de Demande" prefWidth="120" />
                <TableColumn fx:id="colDocType" text="Type de Document" prefWidth="200" />
                <TableColumn fx:id="colReqStatus" text="Statut" prefWidth="120" />
                <TableColumn fx:id="colReqAppDate" text="Date de Validation" prefWidth="120" />
                <TableColumn fx:id="colReqAction" text="Actions / Téléchargement" prefWidth="150" />
            </columns>
        </TableView>
    </VBox>
</VBox>
