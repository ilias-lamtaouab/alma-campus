<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox spacing="24" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.scolaris.controller.ModuleSubjectController">
    
    <HBox alignment="CENTER_LEFT">
        <Label text="Gestion des Modules &amp; Matières" styleClass="header-title" />
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <!-- MODULES TAB -->
        <Tab text="Modules">
            <HBox spacing="20" style="-fx-padding: 20 0 0 0;">
                <!-- Table of Modules (Left) -->
                <VBox styleClass="section-card" HBox.hgrow="ALWAYS" spacing="10">
                    <TableView fx:id="moduleTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colModId" text="ID" prefWidth="50">
                                <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colModCode" text="Code" prefWidth="120">
                                <cellValueFactory><PropertyValueFactory property="code" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colModName" text="Nom" prefWidth="250">
                                <cellValueFactory><PropertyValueFactory property="name" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colModSem" text="Semestre" prefWidth="100">
                                <cellValueFactory><PropertyValueFactory property="semester" /></cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Form for Modules (Right) -->
                <VBox styleClass="section-card" prefWidth="380" spacing="15">
                    <Label text="Formulaire Module" styleClass="section-title" />
                    
                    <VBox spacing="5">
                        <Label text="Code:" />
                        <TextField fx:id="modCodeField" />
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Nom:" />
                        <TextField fx:id="modNameField" />
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Semestre (Entier):" />
                        <Spinner fx:id="modSemSpinner" min="1" max="10" initialValue="1" maxWidth="Infinity" editable="true"/>
                    </VBox>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Vider" onAction="#clearModuleForm" styleClass="btn-secondary" minWidth="-Infinity">
                            <graphic><FontAwesomeIconView glyphName="UNDO" fill="white" size="13"/></graphic>
                        </Button>
                        <Button text="Supprimer" onAction="#handleDeleteModule" styleClass="btn-danger" minWidth="-Infinity">
                            <graphic><FontAwesomeIconView glyphName="TRASH" fill="white" size="13"/></graphic>
                        </Button>
                        <Button fx:id="saveModButton" text="Ajouter" onAction="#handleSaveModule" styleClass="btn-success" minWidth="-Infinity">
                            <graphic><FontAwesomeIconView glyphName="PLUS" fill="white" size="13"/></graphic>
                        </Button>
                    </HBox>
                </VBox>
            </HBox>
        </Tab>

        <!-- SUBJECTS TAB -->
        <Tab text="Matières">
            <HBox spacing="20" style="-fx-padding: 20 0 0 0;">
                <!-- Table of Subjects (Left) -->
                <VBox styleClass="section-card" HBox.hgrow="ALWAYS" spacing="10">
                    <TableView fx:id="subjectTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colSubId" text="ID" prefWidth="50">
                                <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colSubName" text="Matière" prefWidth="200">
                                <cellValueFactory><PropertyValueFactory property="name" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colSubCoef" text="Coefficient" prefWidth="100">
                                <cellValueFactory><PropertyValueFactory property="coefficient" /></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colSubMod" text="Module Associé" prefWidth="180">
                                <!-- Will bind custom text in Controller -->
                            </TableColumn>
                            <TableColumn fx:id="colSubTeacher" text="Enseignant" prefWidth="180">
                                <!-- Will bind custom text in Controller -->
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>

                <!-- Form for Subjects (Right) -->
                <VBox styleClass="section-card" prefWidth="380" spacing="15">
                    <Label text="Formulaire Matière" styleClass="section-title" />
                    
                    <VBox spacing="5">
                        <Label text="Nom de la matière:" />
                        <TextField fx:id="subNameField" />
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Coefficient:" />
                        <TextField fx:id="subCoefField" promptText="ex: 2.0" />
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Module:" />
                        <ComboBox fx:id="subModComboBox" promptText="Sélectionnez un Module" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Enseignant:" />
                        <ComboBox fx:id="subTeacherComboBox" promptText="Sélectionnez un Enseignant" maxWidth="Infinity"/>
                    </VBox>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Vider" onAction="#clearSubjectForm" styleClass="btn-secondary" minWidth="-Infinity">
                            <graphic><FontAwesomeIconView glyphName="UNDO" fill="white" size="13"/></graphic>
                        </Button>
                        <Button text="Supprimer" onAction="#handleDeleteSubject" styleClass="btn-danger" minWidth="-Infinity">
                            <graphic><FontAwesomeIconView glyphName="TRASH" fill="white" size="13"/></graphic>
                        </Button>
                        <Button fx:id="saveSubButton" text="Ajouter" onAction="#handleSaveSubject" styleClass="btn-success" minWidth="-Infinity">
                            <graphic><FontAwesomeIconView glyphName="PLUS" fill="white" size="13"/></graphic>
                        </Button>
                    </HBox>
                </VBox>
            </HBox>
        </Tab>
    </TabPane>

    <Label fx:id="messageLabel" styleClass="error-label" visible="false" />
</VBox>
