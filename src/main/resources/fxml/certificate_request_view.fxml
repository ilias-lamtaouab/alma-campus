<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox spacing="24" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.scolaris.controller.CertificateRequestController">
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Demandes de Certificats de Scolarité" styleClass="header-title" />
    </HBox>

    <VBox styleClass="section-card" VBox.vgrow="ALWAYS" spacing="15">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Demandes Reçues" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0D9488;" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <TableView fx:id="adminRequestTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colStudentCne" text="CNE" prefWidth="100" />
                <TableColumn fx:id="colStudentName" text="Nom &amp; Prénom" prefWidth="200" />
                <TableColumn fx:id="colDocType" text="Type de Document" prefWidth="180" />
                <TableColumn fx:id="colRequestDate" text="Date de Demande" prefWidth="120" />
                <TableColumn fx:id="colStatus" text="Statut" prefWidth="120" />
                <TableColumn fx:id="colApprovedDate" text="Date de Validation" prefWidth="120" />
                <TableColumn fx:id="colActions" text="Actions" prefWidth="200" />
            </columns>
        </TableView>
    </VBox>
</VBox>
