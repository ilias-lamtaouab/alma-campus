<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox spacing="24" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.scolaris.controller.StudentCoursesController">
    <HBox alignment="CENTER_LEFT">
        <Label text="Liste des Enseignements" styleClass="header-title" />
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <VBox styleClass="section-card" spacing="10" VBox.vgrow="ALWAYS">
        <TableView fx:id="coursesTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colModCode" text="Code" prefWidth="80" />
                <TableColumn fx:id="colModName" text="Module" prefWidth="200" />
                <TableColumn fx:id="colSubName" text="Matière" prefWidth="180" />
                <TableColumn fx:id="colCoef" text="Coef" prefWidth="60" />
                <TableColumn fx:id="colTeacherName" text="Enseignant" prefWidth="160" />
            </columns>
        </TableView>
    </VBox>
</VBox>
