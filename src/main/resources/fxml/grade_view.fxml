<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox spacing="24" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.scolaris.controller.GradeController">
    
    <HBox alignment="CENTER_LEFT">
        <Label text="Notes, Averages &amp; Bulletins" styleClass="header-title" />
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        
        <!-- Left Side: Grade recording and list -->
        <VBox spacing="20" HBox.hgrow="ALWAYS">
            <!-- Filter & Recording Form -->
            <VBox styleClass="section-card" spacing="15">
                <Label text="Saisie des Notes" styleClass="section-title" />
                
                <GridPane hgap="15" vgap="15">
                    <Label text="Étudiant:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="studentComboBox" promptText="Sélectionner Étudiant" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity" onAction="#handleStudentSelection"/>

                    <Label text="Matière:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="subjectComboBox" promptText="Sélectionner Matière" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity"/>

                    <Label text="Note (0-20):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="gradeValueField" promptText="ex: 15.5" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Type d'Évaluation:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <ComboBox fx:id="evalTypeComboBox" promptText="Sélectionner Type" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="Infinity"/>

                    <Label text="Date Éval:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <DatePicker fx:id="evalDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>
                    
                    <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.columnIndex="2" GridPane.rowIndex="2" GridPane.columnSpan="2">
                        <Button text="Vider" onAction="#clearGradeForm" styleClass="btn-secondary" minWidth="-Infinity">
                            <graphic><FontAwesomeIconView glyphName="UNDO" fill="white" size="13"/></graphic>
                        </Button>
                        <Button text="Enregistrer" onAction="#handleSaveGrade" styleClass="btn-primary" minWidth="-Infinity">
                            <graphic><FontAwesomeIconView glyphName="SAVE" fill="white" size="13"/></graphic>
                        </Button>
                    </HBox>
                </GridPane>
            </VBox>

            <!-- Table of Student's current Grades -->
            <VBox styleClass="section-card" VBox.vgrow="ALWAYS" spacing="10">
                <Label text="Notes enregistrées" styleClass="section-title" />
                <TableView fx:id="gradeTable" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colGradeId" text="ID" prefWidth="50">
                            <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colGradeSubject" text="Matière" prefWidth="180">
                            <!-- Bound custom display -->
                        </TableColumn>
                        <TableColumn fx:id="colGradeValue" text="Note / 20" prefWidth="90">
                            <cellValueFactory><PropertyValueFactory property="gradeValue" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colGradeType" text="Type" prefWidth="100">
                            <cellValueFactory><PropertyValueFactory property="evaluationType" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colGradeDate" text="Date Évaluation" prefWidth="130">
                            <cellValueFactory><PropertyValueFactory property="evaluationDate" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colGradeAction" text="Actions" prefWidth="90">
                            <!-- Custom cell for deletion -->
                        </TableColumn>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
        
        <!-- Right Side: Averages, Decisions, and Import/Export Panel -->
        <VBox spacing="20" prefWidth="380">
            <!-- Averages and Decision -->
            <VBox styleClass="section-card" spacing="15">
                <Label text="Synthèse &amp; Moyennes" styleClass="section-title" />
                
                <VBox alignment="CENTER" spacing="5" style="-fx-padding: 10; -fx-background-color: #F7F8FA; -fx-background-radius: 8;">
                    <Label text="MOYENNE GÉNÉRALE" style="-fx-font-size: 11px; -fx-text-fill: #667085; -fx-font-weight: bold;" />
                    <Label fx:id="generalAverageLabel" text="0.00 / 20" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0D9488;" />
                </VBox>

                <HBox alignment="CENTER" spacing="10">
                    <Label text="DÉCISION DU JURY :" style="-fx-font-weight: bold; -fx-text-fill: #101828;" />
                    <Label fx:id="decisionLabel" text="-" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 3 8; -fx-background-radius: 5;" />
                </HBox>

                <Separator />

                <Label text="Moyennes par Module :" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #667085;" />
                <ListView fx:id="moduleAveragesListView" prefHeight="150" style="-fx-background-color: transparent; -fx-border-color: transparent;" />
            </VBox>

            <!-- Import / Export Actions -->
            <VBox styleClass="section-card" spacing="15">
                <Label text="Bulletins &amp; Imports/Exports" styleClass="section-title" />
                
                <Button text="Télécharger Bulletin PDF" onAction="#handleExportPDF" styleClass="btn-primary" maxWidth="Infinity">
                    <graphic><FontAwesomeIconView glyphName="FILE_PDF_ALT" fill="white" size="14"/></graphic>
                </Button>

                <Separator />

                <Label text="Importation en masse d'étudiants :" style="-fx-font-size: 12px; -fx-text-fill: #667085;" />
                
                <HBox spacing="10">
                    <Button text="Import CSV" onAction="#handleImportCSV" styleClass="btn-dark" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <graphic><FontAwesomeIconView glyphName="FILE_TEXT_ALT" fill="white" size="14"/></graphic>
                    </Button>
                    <Button text="Import Excel" onAction="#handleImportExcel" styleClass="btn-success" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                        <graphic><FontAwesomeIconView glyphName="FILE_EXCEL_ALT" fill="white" size="14"/></graphic>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
        
    </HBox>

    <Label fx:id="messageLabel" styleClass="error-label" visible="false" />
</VBox>
