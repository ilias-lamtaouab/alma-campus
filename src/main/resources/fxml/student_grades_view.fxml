<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox spacing="24" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.scolaris.controller.StudentGradesController">
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="Mes Notes &amp; Résultats Académiques" styleClass="header-title" />
        <Region HBox.hgrow="ALWAYS" />
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-background-color: white; -fx-padding: 8 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 3);">
            <Label text="Moyenne Générale :" style="-fx-font-weight: bold; -fx-text-fill: #667085;" />
            <Label fx:id="generalAverageLabel" text="0.00 / 20" style="-fx-font-weight: bold; -fx-text-fill: #0D9488; -fx-font-size: 15px;" />
            <Separator orientation="VERTICAL" />
            <Label fx:id="decisionLabel" text="-" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 3 8; -fx-background-radius: 5;" />
        </HBox>
    </HBox>

    <VBox styleClass="section-card" VBox.vgrow="ALWAYS" spacing="15">
        <Label text="Détails des Évaluations par Module" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #0D9488;" />
        <TableView fx:id="detailsTable" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colModCode" text="Code Module" prefWidth="100" />
                <TableColumn fx:id="colModName" text="Nom Module" prefWidth="220" />
                <TableColumn fx:id="colSubName" text="Matière" prefWidth="180" />
                <TableColumn fx:id="colSubCoef" text="Coef" prefWidth="60" />
                <TableColumn fx:id="colCC" text="Note CC" prefWidth="80" />
                <TableColumn fx:id="colProject" text="Note Projet" prefWidth="80" />
                <TableColumn fx:id="colExam" text="Note Examen" prefWidth="80" />
                <TableColumn fx:id="colSubAvg" text="Moyenne" prefWidth="90" />
                <TableColumn fx:id="colModAvg" text="Moy. Mod" prefWidth="90" />
                <TableColumn fx:id="colValidation" text="Validation" prefWidth="80" />
            </columns>
        </TableView>
        
        <HBox alignment="CENTER_RIGHT">
            <Button text="Demander un Document" onAction="#handleRequestDocument" styleClass="btn-primary" minWidth="-Infinity">
                <graphic><FontAwesomeIconView glyphName="FILE_TEXT" fill="white" size="14"/></graphic>
            </Button>
        </HBox>
    </VBox>
</VBox>
